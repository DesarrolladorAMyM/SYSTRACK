                </mxCell>
                <mxCell id="c67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="6 · Calificado   &lt;b&gt;2 221&lt;/b&gt;" vertex="1">
