                    <mxGeometry height="30" width="1000" x="40" y="26" as="geometry"/>
                </mxCell>
                <mxCell id="c89" parent="1" style="text;html=1;fontSize=11;fontColor=#15653A;fontStyle=1;align=left;verticalAlign=top;" value="LAS 3 CATEGORIAS ACTIVAS  (Estado = 1)  —  las unicas que ofrece el desplegable" vertex="1">
                    <mxGeometry height="18" width="500" x="40" y="104" as="geometry"/>
                </mxCell>
                <mxCell id="c90" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;36 &amp;#183; Soporte tecnico Interno&lt;/b&gt;   —   &lt;b&gt;722&lt;/b&gt; vigentes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Hardware (Portatil, Equipo &lt;b&gt;220&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(5 d)&lt;/font&gt; &amp;#183; Software (Sistema Operativ &lt;b&gt;184&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(5 d)&lt;/font&gt; &amp;#183; Erp Siesa (Siesa, Biable,  &lt;b&gt;138&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(5 d)&lt;/font&gt; &amp;#183; Conectividad (Vpn, Carpeta &lt;b&gt;180&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(5 d)&lt;/font&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="62" width="560" x="40" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="c91" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;38 &amp;#183; Desarrollo y Soporte aplicaciones internas&lt;/b&gt;   —   &lt;b&gt;304&lt;/b&gt; vigentes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Desarrollo Aplicación Nuev &lt;b&gt;11&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(150 d)&lt;/font&gt; &amp;#183; Soporte Y Ajuste Aplicacio &lt;b&gt;293&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(15 d)&lt;/font&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="62" width="560" x="40" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="c92" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;37 &amp;#183; Soporte tecnico Externo&lt;/b&gt;   —   &lt;b&gt;302&lt;/b&gt; vigentes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Compras (Mouse, Teclado, D &lt;b&gt;214&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(30 d)&lt;/font&gt; &amp;#183; Mantenimiento &lt;b&gt;37&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(30 d)&lt;/font&gt; &amp;#183; Solicitud De Equipo &lt;b&gt;51&lt;/b&gt; &lt;font color=&quot;#8590A8&quot;&gt;(30 d)&lt;/font&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="62" width="560" x="40" y="270" as="geometry"/>
                </mxCell>
                <mxCell id="c93" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="Suman &lt;b&gt;1 328&lt;/b&gt; requerimientos  ·  9 subcategorias, todas con plazo y prioridad" vertex="1">
                    <mxGeometry height="40" width="560" x="40" y="344" as="geometry"/>
                </mxCell>
                <mxCell id="c94" parent="1" style="text;html=1;fontSize=11;fontColor=#8F5407;fontStyle=1;align=left;verticalAlign=top;" value="LAS RETIRADAS  (Estado = 2)  —  siguen cargando historia de TIC" vertex="1">
                    <mxGeometry height="18" width="500" x="290" y="395" as="geometry"/>
                </mxCell>
                <mxCell id="c95" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="23 &amp;#183; Soporte tecnico   —   &lt;b&gt;410&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 8&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="c96" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="34 &amp;#183; Temas Varios   —   &lt;b&gt;270&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 30&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="c97" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="28 &amp;#183; Soporte VPN   —   &lt;b&gt;140&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 5&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="c98" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="24 &amp;#183; Requerimiento SIESA   —   &lt;b&gt;72&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 30&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="c99" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="39 &amp;#183; Desarrollo y Soporte Analisis De Datos   —   &lt;b&gt;62&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA &amp;#8212;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="c100" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="25 &amp;#183; Soporte de modulos desarrollo interno   —   &lt;b&gt;60&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 150&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="c101" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="31 &amp;#183; Requerimientos Analiticos   —   &lt;b&gt;40&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 30&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="370" as="geometry"/>
                </mxCell>
                <mxCell id="c102" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="29 &amp;#183; Modificación de Reportes   —   &lt;b&gt;7&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 15&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="c103" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="26 &amp;#183; Creación de aplicaciones o nuevos modulos   —   &lt;b&gt;5&lt;/b&gt;   &lt;font color=&quot;#8590A8&quot;&gt;SLA 150&lt;/font&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="c104" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="otras 2 categorias retiradas   —   &lt;b&gt;3&lt;/b&gt;" vertex="1">
                    <mxGeometry height="34" width="490" x="640" y="490" as="geometry"/>
                </mxCell>
                <mxCell id="c105" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;Suman 1 069 requerimientos — el 45 % del total de TIC.&lt;/b&gt;&lt;br&gt;&lt;br&gt;El desplegable de categorias del panel &lt;b&gt;no las ofrece&lt;/b&gt;, asi que esos 1 069 no se pueden filtrar. Ver la pagina de hallazgos." vertex="1">
                    <mxGeometry height="96" width="490" x="640" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="c106" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;LA CADENA DEL PLAZO&lt;/b&gt;&lt;br&gt;&lt;br&gt;subcategoria.TiempoDias  &amp;#8594;  si no hay, categoria.TiempoDias  &amp;#8594;  si no hay, &lt;b&gt;sin fecha estimada&lt;/b&gt;&lt;br&gt;&lt;br&gt;La &lt;b&gt;subcategoria es obligatoria&lt;/b&gt; al crear: sin ella la peticion se rechaza con error 400. Por eso el respaldo por categoria nunca entra.&lt;br&gt;&lt;br&gt;Los &lt;b&gt;597&lt;/b&gt; sin subcategoria son historicos — el mas reciente es del 28/03/2025. De esos, &lt;b&gt;15&lt;/b&gt; quedaron sin fecha estimada." vertex="1">
                    <mxGeometry height="100" width="560" x="40" y="660" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="c133" name="6. Trampas de la base">
        <mxGraphModel dx="1526" dy="774" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c107" parent="1" style="text;html=1;fontSize=20;fontColor=#8F5407;fontStyle=1;align=left;verticalAlign=top;" value="TRAMPAS DE LA BASE DE DATOS" vertex="1">
                    <mxGeometry height="30" width="1000" x="40" y="26" as="geometry"/>
                </mxCell>
                <mxCell id="c108" parent="1" style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=left;verticalAlign=top;" value="Tres fallos que solo aparecieron al programar, no al leer el codigo. Quedan aqui para quien toque estas fechas despues." vertex="1">
                    <mxGeometry height="34" width="1060" x="40" y="54" as="geometry"/>
                </mxCell>
                <mxCell id="c109" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;1 &amp;#183; El modelo miente sobre el tipo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Fecha&lt;/b&gt; y &lt;b&gt;FechaRealSolucion&lt;/b&gt; estan declaradas como &lt;b&gt;DateField&lt;/b&gt; en el modelo, pero en SQL Server las columnas son &lt;b&gt;datetime&lt;/b&gt;, y muchas filas traen hora distinta de medianoche.&lt;br&gt;&lt;br&gt;Al leerlas con values_list() no se construye la instancia del modelo, asi que llegan como datetime y &lt;b&gt;no coinciden&lt;/b&gt; con una clave de tipo date: la serie del grafico salia entera en ceros.&lt;br&gt;&lt;br&gt;&lt;i&gt;Solucion: _solo_fecha()&lt;/i&gt;" vertex="1">
                    <mxGeometry height="250" width="350" x="40" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="c110" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;2 &amp;#183; El filtro cortaba a medianoche&lt;/b&gt;&lt;br&gt;&lt;br&gt;Comparar &lt;b&gt;Fecha &amp;#8804; hoy&lt;/b&gt; contra una columna datetime deja el corte en las &lt;b&gt;00:00 de hoy&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Todo lo registrado hoy despues de medianoche se quedaba fuera del rango, sin ningun aviso: el panel simplemente mostraba menos de lo que habia.&lt;br&gt;&lt;br&gt;&lt;i&gt;Solucion: _fin_exclusivo() — se compara contra el dia siguiente con &amp;lt; en vez de &amp;#8804;&lt;/i&gt;" vertex="1">
                    <mxGeometry height="250" width="350" x="406" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="c111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;3 &amp;#183; &quot;A tiempo&quot; comparaba la hora&lt;/b&gt;&lt;br&gt;&lt;br&gt;FechaRealSolucion &amp;#8804; FechaEstiSolucion sobre dos &lt;b&gt;datetime&lt;/b&gt;: algo resuelto el &lt;b&gt;mismo dia&lt;/b&gt; del plazo a las 15:00 quedaba por encima de ese dia a medianoche y contaba como fuera de plazo.&lt;br&gt;&lt;br&gt;El cumplimiento salia peor de lo real, y sin rastro de por que.&lt;br&gt;&lt;br&gt;&lt;i&gt;Solucion: TruncDate en las dos columnas, para comparar solo dias&lt;/i&gt;" vertex="1">
                    <mxGeometry height="250" width="350" x="772" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="c112" parent="1" style="text;html=1;fontSize=13;fontColor=#A8261C;fontStyle=1;align=left;verticalAlign=top;" value="LO QUE NO SE ARREGLA PROGRAMANDO" vertex="1">
                    <mxGeometry height="20" width="900" x="40" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="c113" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;&quot;En proceso&quot; seguira en 0&lt;/b&gt;&lt;br&gt;&lt;br&gt;El estado 3 solo se activa cuando un tecnico guarda un &lt;b&gt;Plan de accion&lt;/b&gt;, y nadie lo ha usado nunca: jamas ha habido un requerimiento en ese estado.&lt;br&gt;&lt;br&gt;El boton &quot;Solucionar&quot; lleva de Asignado (2) directo a Cerrado (4).&lt;br&gt;&lt;br&gt;&lt;b&gt;Es capacitacion del equipo, no programacion.&lt;/b&gt;" vertex="1">
                    <mxGeometry height="190" width="350" x="40" y="418" as="geometry"/>
                </mxCell>
                <mxCell id="c114" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;La curva semanal de calificacion&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;mv_EvaluacionReq no tiene columna de fecha&lt;/b&gt;. La unica fecha disponible es la del requerimiento asociado, asi que la semana se toma de cuando &lt;b&gt;nacio&lt;/b&gt;, no de cuando se califico.&lt;br&gt;&lt;br&gt;El titulo ya lo dice (&quot;Promedio por semana de ingreso&quot;), pero medir la evolucion real exigiria &lt;b&gt;agregar una columna a esa tabla&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;i&gt;Ver indicador-calificacion.drawio&lt;/i&gt;" vertex="1">
                    <mxGeometry height="190" width="350" x="406" y="418" as="geometry"/>
                </mxCell>
                <mxCell id="c115" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;No es en tiempo real&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los datos se piden al &lt;b&gt;entrar&lt;/b&gt; a la pantalla y al &lt;b&gt;cambiar un filtro&lt;/b&gt;. No hay temporizador ni recarga automatica.&lt;br&gt;&lt;br&gt;Si dejas el panel abierto, los numeros no se mueven aunque entren requerimientos nuevos. Para ver lo ultimo: &lt;b&gt;F5&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;i&gt;Un refresco completo son 31 consultas y ~300 ms.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="190" width="358" x="772" y="418" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="c134" name="7. Hallazgos">
        <mxGraphModel dx="1557" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c116" parent="1" style="text;html=1;fontSize=20;fontColor=#A8261C;fontStyle=1;align=left;verticalAlign=top;" value="HALLAZGOS — revisados contra la base real" vertex="1">
                    <mxGeometry height="30" width="1000" x="40" y="26" as="geometry"/>
                </mxCell>
                <mxCell id="c117" parent="1" style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=left;verticalAlign=top;" value="Lo que se encontro al verificar el panel columna por columna el 30/09/2026 09:53. Ninguno esta corregido todavia." vertex="1">
                    <mxGeometry height="34" width="1060" x="40" y="54" as="geometry"/>
                </mxCell>
                <mxCell id="c118" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;dashed=0;" value="&lt;b&gt;ALTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;El filtro de categorias solo alcanza el &lt;/font&gt;" vertex="1">
                    <mxGeometry height="130" width="200" x="40" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="c119" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A8261C;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;1 &amp;#183; El filtro de categorias solo alcanza el 55 %&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;api_categorias_req&lt;/b&gt; devuelve solo las categorias [36, 37, 38]. Cubren &lt;b&gt;1 328&lt;/b&gt; requerimientos; los otros &lt;b&gt;1 069 no se pueden filtrar&lt;/b&gt; desde el panel.&lt;br&gt;&lt;br&gt;El origen es un uso cruzado: CATEGORIAS_TIC se creo para el &lt;b&gt;modal de asignacion&lt;/b&gt;, para que nadie reclasifique un requerimiento a un area ajena. Ahi es correcta. Reutilizarla para el &lt;b&gt;filtro de lectura&lt;/b&gt; hace lo contrario: esconde historia.&lt;br&gt;&lt;br&gt;&lt;i&gt;Escribir y leer necesitan listas distintas: 3 categorias para asignar, 14 para filtrar.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="130" width="874" x="256" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="c120" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;dashed=0;" value="&lt;b&gt;MEDIO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;La categoria 27 no existe&lt;/font&gt;" vertex="1">
                    <mxGeometry height="130" width="200" x="40" y="256" as="geometry"/>
                </mxCell>
                <mxCell id="c121" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A8261C;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;2 &amp;#183; La categoria 27 no existe&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hay requerimientos de TIC apuntando a &lt;b&gt;IdCategoria = 27&lt;/b&gt;, y esa fila &lt;b&gt;no esta en mm_Categoria&lt;/b&gt;.&lt;br&gt;&lt;br&gt;No revienta nada porque los JOIN son LEFT, pero ese requerimiento sale sin categoria en todas partes y no se puede filtrar por ningun lado.&lt;br&gt;&lt;br&gt;&lt;i&gt;Es integridad referencial rota en la base, no en el codigo.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="130" width="874" x="256" y="256" as="geometry"/>
                </mxCell>
                <mxCell id="c122" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;dashed=0;" value="&lt;b&gt;BAJO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;El respaldo por categoria esta vacio — p&lt;/font&gt;" vertex="1">
                    <mxGeometry height="130" width="200" x="40" y="402" as="geometry"/>
                </mxCell>
                <mxCell id="c123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;3 &amp;#183; El respaldo por categoria esta vacio — pero no hace falta&lt;/b&gt;&lt;br&gt;&lt;br&gt;Las categorias 36, 37 y 38 tienen &lt;b&gt;TiempoDias = NULL&lt;/b&gt;, asi que el respaldo &lt;i&gt;categoria.TiempoDias&lt;/i&gt; nunca entra. &lt;b&gt;Y no hace falta que entre:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; La subcategoria es &lt;b&gt;obligatoria&lt;/b&gt;: crear sin ella devuelve error 400 (requerimientos/views.py, validacion de campos).&lt;br&gt;&amp;#8226; Solo hay &lt;b&gt;un sitio&lt;/b&gt; que crea requerimientos, no hay camino alterno.&lt;br&gt;&amp;#8226; Las &lt;b&gt;9 subcategorias activas traen plazo&lt;/b&gt;, ninguna en NULL.&lt;br&gt;&amp;#8226; En el ultimo ano: &lt;b&gt;0 de 865&lt;/b&gt; sin subcategoria y &lt;b&gt;0&lt;/b&gt; sin fecha estimada.&lt;br&gt;&lt;br&gt;&lt;i&gt;Riesgo que queda: si alguien agrega una subcategoria nueva a 36/37/38 y olvida el TiempoDias, ese requerimiento sale del calculo en silencio y no hay red debajo. Llenar el plazo de las 3 categorias seria esa red.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="130" width="874" x="256" y="402" as="geometry"/>
                </mxCell>
                <mxCell id="c124" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=0;" value="&lt;b&gt;INFORMATIVO&lt;/b&gt;" vertex="1">
                    <mxGeometry height="102" width="200" x="40" y="548" as="geometry"/>
                </mxCell>
                <mxCell id="c125" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;4 &amp;#183; 597 requerimientos sin subcategoria&lt;/b&gt;&lt;br&gt;&lt;br&gt;Es el 25 % del total de TIC. Son los historicos, de cuando las categorias viejas no tenian subcategorias.&lt;br&gt;&lt;br&gt;No es un error, pero explica por que el filtro de subcategoria se siente vacio al mirar hacia atras." vertex="1">
                    <mxGeometry height="102" width="874" x="256" y="548" as="geometry"/>
                </mxCell>
                <mxCell id="c126" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacing=8;dashed=0;" value="&lt;b&gt;INFORMATIVO&lt;/b&gt;" vertex="1">
                    <mxGeometry height="102" width="200" x="40" y="666" as="geometry"/>
                </mxCell>
                <mxCell id="c127" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;5 &amp;#183; Nunca ha habido un eliminado&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;IdEstado = 5 tiene 0 filas&lt;/b&gt; en toda la tabla. El &lt;i&gt;.exclude(IdEstado=5)&lt;/i&gt; que llevan todas las consultas nunca ha descartado nada.&lt;br&gt;&lt;br&gt;Conviene dejarlo por seguridad, pero hay que saber que hoy no hace nada." vertex="1">
                    <mxGeometry height="102" width="874" x="256" y="666" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>