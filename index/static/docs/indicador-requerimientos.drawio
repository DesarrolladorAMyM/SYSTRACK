                </mxCell>
                <mxCell id="c68" edge="1" parent="1" source="c67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#15653A;dashed=0;strokeWidth=1;fontColor=#55607A;" target="c63" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="8 · Rechazado   &lt;b&gt;0&lt;/b&gt;" vertex="1">
                    <mxGeometry height="40" width="250" x="40" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="c70" edge="1" parent="1" source="c69" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#15653A;dashed=0;strokeWidth=1;fontColor=#55607A;" target="c64" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="Finalizados historico   &lt;b&gt;2 363&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;estados 4 y 6 sin recorte de fecha&lt;/font&gt;" vertex="1">
                    <mxGeometry height="44" width="300" x="470" y="622" as="geometry"/>
                </mxCell>
                <mxCell id="c72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=1;spacingLeft=10;" value="5 · Eliminado   &lt;b&gt;0&lt;/b&gt;" vertex="1">
                    <mxGeometry height="40" width="250" x="40" y="622" as="geometry"/>
                </mxCell>
                <mxCell id="c73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8590A8;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;spacing=8;dashed=0;" value="no se cuenta — correcto" vertex="1">
                    <mxGeometry height="30" width="250" x="40" y="674" as="geometry"/>
                </mxCell>
                <mxCell id="c74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;POR QUE LOS DOS GRUPOS NO SE FILTRAN IGUAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pendientes — sin filtro de fecha.&lt;/b&gt;&lt;br&gt;Son estados donde el requerimiento sigue esperando algo. Si se recortaran por fecha, uno sin asignar de hace seis meses desapareceria del panel justo cuando mas hay que mirarlo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cerrados — si respetan el rango.&lt;/b&gt;&lt;br&gt;Ahi la pregunta es de flujo: cuantos se cerraron en el periodo. Se ubican por &lt;b&gt;FechaRealSolucion&lt;/b&gt;, no por la de creacion.&lt;br&gt;&lt;br&gt;&lt;i&gt;Categoria y subcategoria si filtran los dos grupos: son un recorte del universo, no una ventana de tiempo.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="264" width="320" x="810" y="136" as="geometry"/>
                </mxCell>
                <mxCell id="c75" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;RECHAZADO (8) ES EL CASO RARO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un rechazo del jefe es un final sin solucion, asi que &lt;b&gt;no lleva FechaRealSolucion&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Se ubica por &lt;b&gt;FechaAprobacion&lt;/b&gt;, y si esa no quedo registrada, por la fecha de creacion. Es la unica tarjeta con dos criterios de fecha." vertex="1">
                    <mxGeometry height="150" width="320" x="810" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="c76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacing=8;dashed=0;" value="&lt;b&gt;34 + 2 363 = 2 397&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;coincide exacto con el total vigente de TIC&lt;/font&gt;" vertex="1">
                    <mxGeometry height="90" width="320" x="810" y="606" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="c131" name="4. Actividad y medidor">
        <mxGraphModel dx="1146" dy="1191" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c77" parent="1" style="text;html=1;fontSize=20;fontColor=#1B4698;fontStyle=1;align=left;verticalAlign=top;" value="ACTIVIDAD DIARIA Y MEDIDOR DE CUMPLIMIENTO" vertex="1">
                    <mxGeometry height="30" width="1000" x="40" y="26" as="geometry"/>
                </mxCell>
                <mxCell id="c78" parent="1" style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=left;verticalAlign=top;" value="Las dos piezas que responden &quot;&amp;#191;vamos al dia?&quot; y &quot;&amp;#191;cumplimos el plazo?&quot;. Datos leidos de la base REAL el 30/09/2026 09:53. Solo consultas de lectura." vertex="1">
                    <mxGeometry height="34" width="1060" x="40" y="54" as="geometry"/>
                </mxCell>
                <mxCell id="c79" parent="1" style="text;html=1;fontSize=13;fontColor=#55607A;fontStyle=1;align=left;verticalAlign=top;" value="EL GRAFICO" vertex="1">
                    <mxGeometry height="18" width="400" x="40" y="104" as="geometry"/>
                </mxCell>
                <mxCell id="c80" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;Dos series sobre el mismo eje de dias&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#9632; &lt;b&gt;Entraron&lt;/b&gt; — se cuentan por &lt;b&gt;Fecha&lt;/b&gt; (creacion)&lt;br&gt;&amp;#9632; &lt;b&gt;Cerraron&lt;/b&gt; — se cuentan por &lt;b&gt;FechaRealSolucion&lt;/b&gt;, estados 4 y 6&lt;br&gt;&lt;br&gt;Un mismo requerimiento aparece &lt;b&gt;dos veces&lt;/b&gt;: el dia que entro y el dia que se cerro. Eso es justo lo que deja ver si se cierra mas de lo que entra." vertex="1">
                    <mxGeometry height="160" width="520" x="40" y="128" as="geometry"/>
                </mxCell>
                <mxCell id="c81" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;EL BALANCE — como leerlo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entraron &lt;b&gt;109&lt;/b&gt;  &amp;#183;  Cerrados &lt;b&gt;103&lt;/b&gt;  &amp;#183;  &lt;font color=&quot;#A8261C&quot;&gt;&lt;b&gt;(-6)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;No significa que 6 de los 109 sigan abiertos. Son dos grupos distintos que solo se cruzan en parte.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lo que dice de verdad:&lt;/b&gt; la cola de pendientes termino el periodo con 6 requerimientos mas que como empezo." vertex="1">
                    <mxGeometry height="160" width="530" x="600" y="128" as="geometry"/>
                </mxCell>
                <mxCell id="c82" parent="1" style="text;html=1;fontSize=13;fontColor=#55607A;fontStyle=1;align=left;verticalAlign=top;" value="EL MEDIDOR" vertex="1">
                    <mxGeometry height="18" width="400" x="40" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="c83" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;LA FORMULA, PASO A PASO&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Base&lt;/b&gt; = lo cerrado DENTRO del rango por FechaRealSolucion  =  &lt;b&gt;103&lt;/b&gt;&lt;br&gt;&lt;br&gt;2. &lt;b&gt;Se restan&lt;/b&gt; los que no tienen FechaEstiSolucion  =  &lt;b&gt;0&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;sin plazo no hay contra que comparar&lt;/i&gt;&lt;br&gt;&lt;br&gt;3. &lt;b&gt;Medibles&lt;/b&gt;  =  &lt;b&gt;103&lt;/b&gt;&lt;br&gt;&lt;br&gt;4. &lt;b&gt;A tiempo&lt;/b&gt; = los que cumplen FechaRealSolucion &amp;#8804; FechaEstiSolucion, comparando &lt;b&gt;solo el dia&lt;/b&gt;  =  &lt;b&gt;86&lt;/b&gt;&lt;br&gt;&lt;br&gt;5. &lt;b&gt;86 / 103 = 83.5 %&lt;/b&gt;" vertex="1">
                    <mxGeometry height="210" width="520" x="40" y="344" as="geometry"/>
                </mxCell>
                <mxCell id="c84" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;DE DONDE SALE FechaEstiSolucion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se calcula al crear el requerimiento: &lt;b&gt;Fecha + TiempoDias&lt;/b&gt;, tomado primero de la &lt;b&gt;subcategoria&lt;/b&gt; y, si no tiene, de la &lt;b&gt;categoria&lt;/b&gt;." vertex="1">
                    <mxGeometry height="100" width="530" x="600" y="344" as="geometry"/>
                </mxCell>
                <mxCell id="c85" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;LA BASE ANTERIOR ERA OTRA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Antes se median los creados en el rango que ademas estaban cerrados: &lt;b&gt;82&lt;/b&gt;. Eso ignoraba &lt;b&gt;21&lt;/b&gt; que se cerraron dentro del periodo pero entraron antes — los que MAS tardaron — y el porcentaje salia inflado." vertex="1">
                    <mxGeometry height="94" width="530" x="600" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="c86" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;DETALLE QUE CAMBIA EL RESULTADO:&lt;/b&gt; los dos extremos del rango se incluyen, asi que &quot;ultimos 30 dias&quot; se calcula como &lt;b&gt;hoy &amp;#8722; 29&lt;/b&gt;, no hoy &amp;#8722; 30. Con la resta anterior el rango traia 31 dias y el porcentaje se calculaba sobre un dia de mas." vertex="1">
                    <mxGeometry height="76" width="1090" x="40" y="586" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="c132" name="5. Categorias y subcategorias">
