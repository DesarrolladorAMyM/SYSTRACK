                <mxCell id="k1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B4698;fontSize=12;" value="Sin asignar &lt;b&gt;0&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8590A8&quot; style=&quot;font-size:10px&quot;&gt;los 16 de antes eran de SST y Jurídica&lt;/font&gt;" vertex="1">
                    <mxGeometry height="40" width="250" x="625" y="145" as="geometry"/>
