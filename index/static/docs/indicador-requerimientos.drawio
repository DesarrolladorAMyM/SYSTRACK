                </mxCell>
                <mxCell id="c38" edge="1" parent="1" source="c32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#1B4698;dashed=0;strokeWidth=1;fontColor=#55607A;" target="c37" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;LO QUE QUEDA FUERA — y por que importa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los 274 requerimientos de SST y Juridica no son un detalle:&lt;br&gt;&lt;br&gt;&amp;#8226; Se contaban como trabajo de TIC en todas las tarjetas.&lt;br&gt;&lt;br&gt;&amp;#8226; Entre ellos habia &lt;b&gt;16 &amp;quot;sin asignar&amp;quot;&lt;/b&gt;, el mas viejo de hace mas de dos anos, que hacian ver a TIC con una cola que no era suya.&lt;br&gt;&lt;br&gt;&amp;#8226; TIC hoy tiene &lt;b&gt;0 sin asignar&lt;/b&gt;." vertex="1">
                    <mxGeometry height="200" width="320" x="400" y="232" as="geometry"/>
                </mxCell>
                <mxCell id="c40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;POR QUE POR AREA Y NO POR CATEGORIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Existe la constante &lt;b&gt;CATEGORIAS_TIC = [36, 37, 38]&lt;/b&gt;, que son las categorias &lt;b&gt;activas&lt;/b&gt;. Sirve para que nadie reclasifique un requerimiento nuevo a un area ajena, y para eso esta bien.&lt;br&gt;&lt;br&gt;Pero filtrar el panel con ella esconde &lt;b&gt;1 069 requerimientos que SI son de TIC&lt;/b&gt;, registrados bajo categorias ya retiradas.&lt;br&gt;&lt;br&gt;&lt;i&gt;El area de un requerimiento no cambia. Su categoria si, cada vez que se reorganiza el catalogo.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="200" width="370" x="760" y="232" as="geometry"/>
                </mxCell>
                <mxCell id="c41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" value="&lt;b&gt;Eliminados (IdEstado = 5): 0 en toda la tabla.&lt;/b&gt;  El filtro &lt;i&gt;.exclude(IdEstado=5)&lt;/i&gt; se deja por seguridad, pero hoy no descarta ninguna fila." vertex="1">
                    <mxGeometry height="66" width="730" x="400" y="460" as="geometry"/>
                </mxCell>
            </root>
