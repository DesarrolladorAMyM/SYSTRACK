<mxfile host="app.diagrams.net" agent="systraker" version="24.7.17">
  <diagram id="c178" name="1. De donde sale">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c135" value="CALIFICACION — DE DONDE SALE" style="text;html=1;fontSize=20;fontColor=#6B3FA0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="c136" value="La satisfaccion que deja el usuario cuando le resuelven el requerimiento. No es la puntualidad del tecnico: son cosas distintas. Datos leidos de la base REAL el 30/09/2026 09:53. Solo consultas de lectura." style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1060" height="34" as="geometry"/></mxCell>
        <mxCell id="c137" value="&lt;b&gt;PASO 1 — Filtro&lt;/b&gt;&lt;br&gt;&lt;br&gt;rango de dias&lt;br&gt;+ categoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="c138" value="&lt;b&gt;PASO 2 — mv_Requerimientos&lt;/b&gt;&lt;br&gt;&lt;br&gt;filtra por &lt;b&gt;Fecha&lt;/b&gt; (creacion)&lt;br&gt;&lt;b&gt;109&lt;/b&gt; requerimientos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="c139" value="&lt;b&gt;PASO 3 — mv_EvaluacionReq&lt;/b&gt;&lt;br&gt;&lt;br&gt;IdReq IN (subconsulta)&lt;br&gt;&lt;b&gt;63&lt;/b&gt; evaluaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="c140" value="&lt;b&gt;PASO 4 — Pantalla&lt;/b&gt;&lt;br&gt;&lt;br&gt;promedio &lt;b&gt;4.9&lt;/b&gt;&lt;br&gt;63 de 82 (77 %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9F8;strokeColor=#6B3FA0;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="c141" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#1B4698;dashed=0;strokeWidth=1;fontColor=#55607A;" edge="1" parent="1" source="c137" target="c138"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c142" value="los Codigo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#15653A;dashed=0;strokeWidth=2;fontColor=#55607A;" edge="1" parent="1" source="c138" target="c139"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c143" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6B3FA0;dashed=0;strokeWidth=1;fontColor=#55607A;" edge="1" parent="1" source="c139" target="c140"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c144" value="&amp;#9650; la fecha se aplica AQUI" style="text;html=1;fontSize=11;fontColor=#1B4698;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="320" y="226" width="250" height="18" as="geometry"/></mxCell>
        <mxCell id="c145" value="&amp;#9650; aqui ya no hay fechas" style="text;html=1;fontSize=11;fontColor=#8F5407;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="226" width="250" height="18" as="geometry"/></mxCell>
        <mxCell id="c146" value="&lt;b&gt;LA COBERTURA, QUE ANTES NO SE VEIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;La pantalla dice &lt;b&gt;&quot;63 de 82 cerrados calificaron (77 %)&quot;&lt;/b&gt; en vez de un conteo suelto.&lt;br&gt;&lt;br&gt;Un 4,9 sacado de 5 respuestas sobre 200 cerrados no vale lo mismo que uno sacado de 180, y antes los dos se veian igual.&lt;br&gt;&lt;br&gt;Si la cobertura baja del &lt;b&gt;50 %&lt;/b&gt;, sale un aviso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="530" height="160" as="geometry"/></mxCell>
        <mxCell id="c147" value="&lt;b&gt;CONTEXTO HISTORICO&lt;/b&gt;&lt;br&gt;&lt;br&gt;En todo el historico de TIC califico &lt;b&gt;1 de cada 5&lt;/b&gt;: 496 evaluaciones sobre 2 363 finalizados (21 %).&lt;br&gt;&lt;br&gt;En los ultimos 30 dias sube al &lt;b&gt;77 %&lt;/b&gt;, que es mucho mejor, pero sigue dejando fuera a uno de cada cuatro." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="530" height="160" as="geometry"/></mxCell>
        <mxCell id="c148" value="&lt;b&gt;DISTRIBUCION DE NOTAS EN EL RANGO:&lt;/b&gt;  &lt;b&gt;1&amp;#9733;&lt;/b&gt; 0 &amp;#183; &lt;b&gt;2&amp;#9733;&lt;/b&gt; 0 &amp;#183; &lt;b&gt;3&amp;#9733;&lt;/b&gt; 0 &amp;#183; &lt;b&gt;4&amp;#9733;&lt;/b&gt; 6 &amp;#183; &lt;b&gt;5&amp;#9733;&lt;/b&gt; 57&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;El promedio de 4.9 no esconde una cola de insatisfechos: la masa esta en 5.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1090" height="66" as="geometry"/></mxCell>
        <mxCell id="c149" value="&lt;b&gt;SIGUE IGUAL — y hay que saberlo:&lt;/b&gt; el filtro de fechas &lt;b&gt;nunca toca las evaluaciones&lt;/b&gt;. Toca los requerimientos, y las notas vienen arrastradas por el codigo de cada uno.&lt;br&gt;&lt;br&gt;Si alguien califica HOY un requerimiento creado hace tres meses, esa evaluacion &lt;b&gt;no aparece&lt;/b&gt; en el rango de 30 dias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="1090" height="96" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c179" name="2. La tabla sin fecha">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c150" value="LA TABLA QUE NO TIENE FECHA" style="text;html=1;fontSize=20;fontColor=#8F5407;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="c151" value="El limite de fondo del indicador. No se arreglo porque no se puede arreglar programando: la columna no existe." style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1060" height="34" as="geometry"/></mxCell>
        <mxCell id="c152" value="&lt;b&gt;mv_EvaluacionReq&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9F8;strokeColor=#6B3FA0;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="c153" value="IdEvaluacion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="172" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c154" value="IdReq   &lt;font color=&quot;#8590A8&quot;&gt;&amp;#8594; enlaza con Codigo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c155" value="Evaluacion  (1 a 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="248" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c156" value="Comentario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B3FA0;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="286" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c157" value="&lt;b&gt;SIN COLUMNA DE FECHA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="c158" value="&lt;b&gt;mv_Requerimientos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="c159" value="Codigo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B4698;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="430" y="172" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c160" value="Fecha  (de creacion)   &lt;font color=&quot;#8590A8&quot;&gt;&amp;#8592; se toma prestada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B4698;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="430" y="210" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c161" value="FechaRealSolucion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B4698;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="430" y="248" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c162" value="IdEstado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B4698;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="430" y="286" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="c163" value="&lt;b&gt;QUE SIGNIFICA CADA PUNTO DE LA CURVA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dice:&lt;/b&gt; que nota sacaron, en promedio, los requerimientos que &lt;b&gt;NACIERON&lt;/b&gt; esa semana.&lt;br&gt;&lt;br&gt;&lt;b&gt;No dice:&lt;/b&gt; como evoluciono la satisfaccion semana a semana.&lt;br&gt;&lt;br&gt;Para arreglarlo de verdad haria falta &lt;b&gt;agregar una columna de fecha a mv_EvaluacionReq&lt;/b&gt;, que vive en la base de requerimientos y Django no administra (managed=False).&lt;br&gt;&lt;br&gt;&lt;i&gt;Es un cambio de base de datos, con su propio riesgo, y hay que decidirlo aparte.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="790" y="130" width="340" height="250" as="geometry"/></mxCell>
        <mxCell id="c164" value="&lt;b&gt;LO QUE SI SE HIZO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#9632; El grafico se renombro a &lt;b&gt;&quot;Promedio por semana de ingreso&quot;&lt;/b&gt;: ahora el titulo dice lo que el dato realmente es, en vez de aparentar otra cosa.&lt;br&gt;&lt;br&gt;&amp;#9632; Las semanas sin evaluaciones aparecen como un &lt;b&gt;corte en la linea&lt;/b&gt;. Antes solo venian las semanas con datos y la curva unia puntos separados por meses como si fueran consecutivos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="1070" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c180" name="3. El IN resuelto">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c165" value="LA LISTA DE CODIGOS QUE CRECIA — resuelto" style="text;html=1;fontSize=20;fontColor=#15653A;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="c166" value="No fallaba, pero el margen se consumia solo con cada requerimiento nuevo." style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1060" height="34" as="geometry"/></mxCell>
        <mxCell id="c167" value="ANTES — un parametro por cada codigo" style="text;html=1;fontSize=12;fontColor=#8590A8;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="c168" value="30 dias" style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="100" height="20" as="geometry"/></mxCell>
        <mxCell id="c169" value="&lt;b&gt;109&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="45" height="32" as="geometry"/></mxCell>
        <mxCell id="c170" value="365 dias" style="text;html=1;fontSize=12;fontColor=#55607A;fontStyle=0;align=right;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="100" height="20" as="geometry"/></mxCell>
        <mxCell id="c171" value="&lt;b&gt;859&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;strokeWidth=1;fontSize=11;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="160" y="188" width="357" height="32" as="geometry"/></mxCell>
        <mxCell id="c172" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A8261C;strokeColor=#A8261C;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1035" y="120" width="4" height="130" as="geometry"/></mxCell>
        <mxCell id="c173" value="LIMITE SQL SERVER  2 100" style="text;html=1;fontSize=11;fontColor=#A8261C;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="965" y="96" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="c174" value="AHORA — una sola subconsulta" style="text;html=1;fontSize=12;fontColor=#15653A;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="c175" value="cualquier rango &amp;#8594; &lt;b&gt;1 subconsulta&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="160" y="284" width="300" height="36" as="geometry"/></mxCell>
        <mxCell id="c176" value="&lt;b&gt;ANTES&lt;/b&gt;&lt;br&gt;codigos = list(req_qs.values_list(&quot;Codigo&quot;, flat=True))&lt;br&gt;.filter(IdReq__in=codigos)&lt;br&gt;&lt;br&gt;&lt;b&gt;AHORA&lt;/b&gt;&lt;br&gt;.filter(IdReq__in=req_qs.values(&quot;Codigo&quot;))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="610" height="130" as="geometry"/></mxCell>
        <mxCell id="c177" value="&lt;b&gt;RESULTADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los codigos ya no viajan a Python ni vuelven como parametros sueltos: SQL Server resuelve la subconsulta por dentro, asi que el numero de requerimientos deja de importar.&lt;br&gt;&lt;br&gt;Probado con 365 dias: &lt;b&gt;270 evaluaciones sobre 825 cerrados&lt;/b&gt;, sin errores. Filtrar por area bajo el pico a &lt;b&gt;859&lt;/b&gt; parametros y dio aire, pero el techo de SQL Server sigue ahi: la subconsulta es lo que lo quita de en medio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;dashed=0;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1090" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
