    <diagram id="cg1" name="1. Camino de dos saltos">
        <mxGraphModel dx="1500" dy="675" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#6B3FA0;" value="INDICADOR DE CALIFICACIÓN — Cómo funciona" vertex="1">
                    <mxGeometry height="30" width="800" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="t1b" parent="1" style="text;html=1;fontSize=12;fontColor=#55607A;" value="Estado tras la corrección del 28/09/2026. La satisfacción que deja el usuario cuando le resuelven su requerimiento. Solo requerimientos del área de TIC." vertex="1">
                    <mxGeometry height="20" width="900" x="40" y="58" as="geometry"/>
                </mxCell>
                <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9F8;strokeColor=#6B3FA0;fontSize=12;verticalAlign=top;spacing=10;" value="&lt;b&gt;PASO 1 — Filtro&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rango de días&lt;br&gt;+ categoría" vertex="1">
                    <mxGeometry height="110" width="220" x="40" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;fontSize=12;verticalAlign=top;spacing=10;" value="&lt;b&gt;PASO 2 — mv_Requerimientos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Filtra por Fecha (creación)&lt;br&gt;&lt;b&gt;103 requerimientos&lt;/b&gt;" vertex="1">
                    <mxGeometry height="110" width="220" x="320" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;verticalAlign=top;spacing=10;" value="&lt;b&gt;PASO 3 — mv_EvaluacionReq&lt;/b&gt;&lt;br&gt;&lt;br&gt;IdReq IN (subconsulta)&lt;br&gt;&lt;b&gt;56 evaluaciones&lt;/b&gt;" vertex="1">
                    <mxGeometry height="110" width="220" x="600" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B3FA0;fontSize=12;verticalAlign=top;spacing=10;" value="&lt;b&gt;PASO 4 — Pantalla&lt;/b&gt;&lt;br&gt;&lt;br&gt;Promedio &lt;b&gt;4,89&lt;/b&gt;&lt;br&gt;56 de 74 (76 %)&lt;br&gt;Barras 1 a 5 · curva" vertex="1">
                    <mxGeometry height="110" width="220" x="880" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="e1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B3FA0;strokeWidth=2;" target="s2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B3FA0;strokeWidth=2;" target="s3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B3FA0;strokeWidth=2;" target="s4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF9;strokeColor=#1B4698;fontSize=11;" value="La fecha se aplica AQUÍ" vertex="1">
                    <mxGeometry height="34" width="200" x="330" y="300" as="geometry"/>
                </mxCell>
                <mxCell id="m2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;fontSize=11;" value="Aquí ya no hay fechas" vertex="1">
                    <mxGeometry height="34" width="200" x="610" y="300" as="geometry"/>
                </mxCell>
                <mxCell id="em1" edge="1" parent="1" source="m1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B4698;dashed=1;" target="s2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="em2" edge="1" parent="1" source="m2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A8261C;dashed=1;" target="s3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="fix" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;CORREGIDO — la subconsulta&lt;/b&gt;&lt;br&gt;&lt;br&gt;Antes los códigos se traían a Python y viajaban uno por uno dentro del IN. Con un rango de un año son hoy &lt;b&gt;861&lt;/b&gt; parámetros y SQL Server corta cerca de &lt;b&gt;2 100&lt;/b&gt;: no fallaba todavía, pero el margen se consumía solo con cada requerimiento nuevo.&lt;br&gt;&lt;br&gt;Ahora se pasa la consulta entera como subconsulta y SQL Server la resuelve por dentro. &lt;b&gt;Probado con 365 días: responde bien.&lt;/b&gt;" vertex="1">
                    <mxGeometry height="180" width="500" x="40" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="cob" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;NUEVO — la cobertura a la vista&lt;/b&gt;&lt;br&gt;&lt;br&gt;La pantalla ahora dice &lt;b&gt;&quot;56 de 74 cerrados calificaron (76 %)&quot;&lt;/b&gt; en vez de un conteo suelto.&lt;br&gt;&lt;br&gt;Si la cobertura baja del 50 %, sale un aviso: el promedio refleja a quienes respondieron, no a todos.&lt;br&gt;&lt;br&gt;Contexto: en todo el histórico de TIC solo calificó 1 de cada 5 (487 de 2 352). En los últimos 30 días sube al 76 %." vertex="1">
                    <mxGeometry height="180" width="500" x="580" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="lim" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0DC;strokeColor=#8F5407;align=left;verticalAlign=middle;spacing=10;fontSize=12;" value="&lt;b&gt;SIGUE IGUAL:&lt;/b&gt; el filtro de fechas nunca toca las evaluaciones — toca los requerimientos, y las notas vienen arrastradas por el código de cada uno. Si alguien califica HOY un requerimiento creado hace 3 meses, esa evaluación no aparece en el rango de 30 días." vertex="1">
                    <mxGeometry height="60" width="1040" x="40" y="600" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="cg2" name="2. La tabla sin fecha">
        <mxGraphModel dx="1425" dy="641" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
            <root>
