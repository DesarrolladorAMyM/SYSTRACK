                </mxCell>
                <mxCell id="ta4" parent="ta" style="text;html=1;fontSize=12;strokeColor=none;fillColor=#FFFFFF;align=left;spacingLeft=12;" value="Comentario" vertex="1">
                    <mxGeometry height="34" width="300" y="142" as="geometry"/>
                </mxCell>
                <mxCell id="ta5" parent="ta" style="text;html=1;fontSize=12;fontStyle=1;strokeColor=#A8261C;fillColor=#FBE9E6;align=center;dashed=1;" value="SIN COLUMNA DE FECHA" vertex="1">
                    <mxGeometry height="36" width="300" y="178" as="geometry"/>
                </mxCell>
                <mxCell id="tb" parent="1" style="swimlane;html=1;startSize=34;fillColor=#E8EEF9;strokeColor=#1B4698;fontSize=13;fontStyle=1;" value="mv_Requerimientos" vertex="1">
                    <mxGeometry height="214" width="300" x="680" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="tb1" parent="tb" style="text;html=1;fontSize=12;strokeColor=none;fillColor=#FFFFFF;align=left;spacingLeft=12;" value="Codigo" vertex="1">
                    <mxGeometry height="34" width="300" y="34" as="geometry"/>
                </mxCell>
                <mxCell id="tb2" parent="tb" style="text;html=1;fontSize=12;fontStyle=1;strokeColor=#A8261C;fillColor=#FBE9E6;align=left;spacingLeft=12;" value="Fecha   (de creación)" vertex="1">
                    <mxGeometry height="34" width="300" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="tb3" parent="tb" style="text;html=1;fontSize=12;strokeColor=none;fillColor=#FFFFFF;align=left;spacingLeft=12;" value="FechaRealSolucion" vertex="1">
                    <mxGeometry height="34" width="300" y="106" as="geometry"/>
                </mxCell>
                <mxCell id="tb4" parent="tb" style="text;html=1;fontSize=12;strokeColor=none;fillColor=#FFFFFF;align=left;spacingLeft=12;" value="IdEstado" vertex="1">
                    <mxGeometry height="34" width="300" y="142" as="geometry"/>
                </mxCell>
                <mxCell id="j1" edge="1" parent="1" source="ta2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B3FA0;fontSize=11;" target="tb1" value="IdReq = Codigo">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="j2" edge="1" parent="1" source="tb2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A8261C;strokeWidth=2;fontSize=11;fontColor=#A8261C;dashed=1;" target="ta3" value="de aquí se toma prestada la semana">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="res" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E6;strokeColor=#A8261C;align=left;verticalAlign=top;spacing=12;fontSize=13;" value="&lt;b&gt;LO QUE SIGNIFICA CADA PUNTO DE LA CURVA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dice: &quot;qué nota sacaron, en promedio, los requerimientos que NACIERON esa semana&quot;.&lt;br&gt;NO dice: &quot;cómo evolucionó la satisfacción semana a semana&quot;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Para arreglarlo de verdad haría falta agregar una columna de fecha a mv_EvaluacionReq&lt;/b&gt;, que vive en la base de requerimientos y Django no administra (managed=False). Es un cambio de base de datos, con su propio riesgo, y hay que decidirlo aparte." vertex="1">
                    <mxGeometry height="160" width="900" x="80" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="hecho" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontSize=12;" value="&lt;b&gt;LO QUE SÍ SE HIZO&lt;/b&gt;&lt;br&gt;&lt;br&gt;■ El gráfico se renombró a &lt;b&gt;&quot;Promedio por semana de ingreso&quot;&lt;/b&gt;: ahora el título dice lo que el dato realmente es.&lt;br&gt;■ Las semanas sin evaluaciones aparecen como un corte en la línea. Antes solo venían las semanas con datos y la curva unía puntos separados por meses como si fueran seguidos." vertex="1">
                    <mxGeometry height="120" width="900" x="80" y="570" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="cg3" name="3. El IN — resuelto">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t3" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#15653A;" value="LA LISTA DE CÓDIGOS QUE CRECÍA — resuelto" vertex="1">
                    <mxGeometry height="30" width="900" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="t3b" parent="1" style="text;html=1;fontSize=12;fontColor=#55607A;" value="Era una bomba de tiempo: no fallaba hoy, pero el margen se consumía solo con cada requerimiento nuevo. Las barras son los requerimientos de TIC de cada rango, uno por parámetro." vertex="1">
                    <mxGeometry height="20" width="900" x="40" y="58" as="geometry"/>
                </mxCell>
                <mxCell id="ha" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#8590A8;" value="ANTES — un parámetro por cada código" vertex="1">
                    <mxGeometry height="20" width="500" x="40" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="l30" parent="1" style="text;html=1;fontSize=12;align=right;" value="30 días" vertex="1">
                    <mxGeometry height="30" width="100" x="40" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="b30" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;fontSize=11;align=left;spacingLeft=6;" value="103" vertex="1">
                    <mxGeometry height="30" width="43" x="160" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="l90" parent="1" style="text;html=1;fontSize=12;align=right;" value="90 días" vertex="1">
                    <mxGeometry height="30" width="100" x="40" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="b90" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;fontSize=11;align=left;spacingLeft=6;" value="276" vertex="1">
                    <mxGeometry height="30" width="115" x="160" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="l180" parent="1" style="text;html=1;fontSize=12;align=right;" value="180 días" vertex="1">
                    <mxGeometry height="30" width="100" x="40" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="b180" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F8;strokeColor=#8590A8;fontSize=11;align=left;spacingLeft=6;" value="492" vertex="1">
                    <mxGeometry height="30" width="205" x="160" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="l365" parent="1" style="text;html=1;fontSize=12;align=right;fontStyle=1" value="365 días" vertex="1">
                    <mxGeometry height="30" width="100" x="40" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="b365" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8F5407;strokeColor=#8F5407;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=6;fontStyle=1" value="861" vertex="1">
                    <mxGeometry height="30" width="359" x="160" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="lim" parent="1" style="line;strokeWidth=3;direction=north;html=1;strokeColor=#A8261C;dashed=1;" value="" vertex="1">
                    <mxGeometry height="185" width="20" x="1035" y="115" as="geometry"/>
                </mxCell>
                <mxCell id="limt" parent="1" style="text;html=1;fontSize=11;fontColor=#A8261C;align=center;" value="LÍMITE SQL SERVER&lt;br&gt;&lt;b&gt;2 100 parámetros&lt;/b&gt;" vertex="1">
                    <mxGeometry height="34" width="160" x="965" y="82" as="geometry"/>
                </mxCell>
                <mxCell id="ax" parent="1" style="line;strokeWidth=1;html=1;strokeColor=#8590A8;" value="" vertex="1">
                    <mxGeometry height="10" width="885" x="160" y="295" as="geometry"/>
                </mxCell>
                <mxCell id="hb" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#15653A;" value="AHORA — una sola subconsulta" vertex="1">
                    <mxGeometry height="20" width="500" x="40" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="bn" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;fontSize=12;align=left;spacingLeft=10;" value="cualquier rango → &lt;b&gt;1 subconsulta&lt;/b&gt;" vertex="1">
                    <mxGeometry height="34" width="260" x="160" y="378" as="geometry"/>
                </mxCell>
                <mxCell id="cod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15653A;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Courier New;" value="&lt;b&gt;ANTES&lt;/b&gt;&lt;br&gt;codigos = list(req_qs...)&lt;br&gt;filter(IdReq__in=codigos)&lt;br&gt;&lt;br&gt;&lt;b&gt;AHORA&lt;/b&gt;&lt;br&gt;filter(IdReq__in=req_qs.values(&#39;Codigo&#39;))" vertex="1">
                    <mxGeometry height="130" width="500" x="580" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="nt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2E8;strokeColor=#15653A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontSize=13;" value="&lt;b&gt;RESULTADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los códigos ya no viajan a Python ni vuelven como parámetros sueltos: SQL Server resuelve la subconsulta por dentro, así que el número de requerimientos deja de importar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Probado con 365 días: 265 evaluaciones sobre 824 cerrados, sin errores.&lt;br&gt;&lt;br&gt;Filtrar por área bajó el pico de 1 216 a 861 parámetros y dio aire, pero el techo de SQL Server sigue ahí: la subconsulta es lo que lo quita de en medio.&lt;/b&gt;" vertex="1">
                    <mxGeometry height="200" width="700" x="160" y="500" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>