                <mxCell id="t2" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#A8261C;" value="LA TABLA QUE NO TIENE FECHA — límite que sigue vigente" vertex="1">
                    <mxGeometry height="30" width="900" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="t2b" parent="1" style="text;html=1;fontSize=12;fontColor=#55607A;" value="Esto NO se arregló porque no se puede arreglar programando: la columna no existe. Lo único que cambió es que el título ya no aparenta otra cosa." vertex="1">
                    <mxGeometry height="20" width="1000" x="40" y="58" as="geometry"/>
                </mxCell>
                <mxCell id="ta" parent="1" style="swimlane;html=1;startSize=34;fillColor=#F0E9F8;strokeColor=#6B3FA0;fontSize=13;fontStyle=1;" value="mv_EvaluacionReq" vertex="1">
